{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:6358",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__DefaultConnection": "Server=localhost;Database=AgileFlow_Development;Trusted_Connection=True;TrustServerCertificate=true;",
        "Jwt__Issuer": "AgileFlow",
        "Jwt__Audience": "AgileFlow.Client",
        "Jwt__Key": "AgileFlowDevelopmentJwtKey1234567890!",
        "Jwt__ExpiryMinutes": "60"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:2235;http://localhost:6358",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__DefaultConnection": "Server=localhost;Database=AgileFlow_Development;Trusted_Connection=True;TrustServerCertificate=true;",
        "Jwt__Issuer": "AgileFlow",
        "Jwt__Audience": "AgileFlow.Client",
        "Jwt__Key": "AgileFlowDevelopmentJwtKey1234567890!",
        "Jwt__ExpiryMinutes": "60"
      }
    }
  }
}
